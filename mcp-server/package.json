{
  "name": "bookbuilder-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for BookBuilder chess analysis tools",
  "main": "src/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "mcp",
    "chess",
    "analysis",
    "stockfish",
    "lichess"
  ],
  "author": "BookBuilder Team",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "babel-jest": "^30.1.2",
    "jest": "^29.5.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(js|jsx|mjs)$": "babel-jest"
    },
    "moduleFileExtensions": ["js", "mjs", "json"],
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
