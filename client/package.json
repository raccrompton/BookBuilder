{
  "name": "bookbuilder-client",
  "version": "1.0.0",
  "description": "Client-side JavaScript implementation of BookBuilder chess opening repertoire generator",
  "main": "app.html",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration.test.js",
    "test:ui": "jest tests/ui-automation.test.js",
    "test:all": "jest --testPathPattern='(integration|ui-automation|bookbuilder)'",
    "test:quick": "jest --testPathPattern='(unit|chess-engine)'",
    "dev": "http-server . -p 3000 -c-1 --ext js",
    "build": "npm run test:quick && npm run build:dist",
    "build:dist": "mkdir -p dist && cp app.html dist/index.html && cp -r src dist/",
    "lint": "eslint src/ tests/ --ext .js",
    "format": "prettier --write src/ tests/",
    "serve": "http-server dist -p 8080 -c-1",
    "validate": "npm run lint && npm run test:all",
    "test:manual": "echo 'Open http://localhost:3000/app.html for manual testing' && npm run dev",
    "test:cross-system": "jest tests/cross-system-validation.test.js",
    "test:cross-system:coverage": "jest tests/cross-system-validation.test.js --coverage",
    "test:performance": "jest tests/engine-performance.test.js",
    "test:performance:quick": "jest tests/engine-performance.test.js --testNamePattern='measures engine timing at configured depths'",
    "test:performance:browser": "jest --config jest.browser.config.js tests/browser/engine-browser-performance.test.js",
    "test:performance:real": "jest --config jest.browser.config.js tests/browser/engine-browser-performance.test.js --testNamePattern='real engine performance'",
    "test:browser": "npx playwright test",
    "test:browser:headed": "npx playwright test --headed",
    "test:browser:debug": "npx playwright test --debug",
    "test:real-engine": "USE_REAL_ENGINE=true jest",
    "test:node-engine": "jest tests/node-engine-parity.test.js",
    "test:real-engine:integration": "USE_REAL_ENGINE=true jest tests/integration.test.js",
    "test:real-engine:bookbuilder": "USE_REAL_ENGINE=true jest tests/bookbuilder.test.js"
  },
  "keywords": [
    "chess",
    "opening",
    "repertoire",
    "pgn",
    "stockfish",
    "lichess"
  ],
  "author": "BookBuilder Team",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@mliebelt/pgn-parser": "^1.4.18",
    "chess.js": "^1.4.0",
    "chessops": "^0.15.0",
    "stockfish": "^17.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@playwright/test": "^1.57.0",
    "@types/jest": "^29.5.0",
    "babel-jest": "^30.1.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.8.0",
    "http-server": "^14.1.1",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "playwright": "^1.40.0",
    "prettier": "^2.8.8"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/browser/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^/node_modules/chess\\.js/dist/esm/chess\\.js$": "<rootDir>/node_modules/chess.js/dist/esm/chess.js"
    },
    "transform": {
      "^.+\\.(js|jsx|ts|tsx|mjs)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(chess\\.js|chessops|@badrap)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
